# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# --- LLM provider --------------------------------------------------------
# Which vendor backs every model call: gemini (default) | anthropic | openai.
# Switching only needs this line + that provider's API key below; per-role model
# ids default sensibly per provider and can be pinned with MODEL_* further down.
LLM_PROVIDER=gemini

# --- Google Gemini (default provider) ------------------------------------
# Required in production when LLM_PROVIDER=gemini. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# --- Anthropic / Claude (LLM_PROVIDER=anthropic) -------------------------
# Required in production when LLM_PROVIDER=anthropic. Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Max output tokens per call / per streamed call (defaults shown).
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_STREAM_MAX_TOKENS=16000

# --- OpenAI (LLM_PROVIDER=openai) ----------------------------------------
# Required in production when LLM_PROVIDER=openai. Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Max completion tokens per call / per streamed call. On reasoning models this
# budget also covers hidden reasoning tokens, so keep it well above the
# visible output a script needs (defaults shown).
OPENAI_MAX_TOKENS=16000
OPENAI_STREAM_MAX_TOKENS=32000

# --- Timeouts and retries (every provider) --------------------------------
# Client timeout per model call in seconds, the longer budget for the Pro-mode
# model (MODEL_PRO_MAX: Pro drafts and report drafts), and how many times a
# transient failure (429 / 5xx / timeout) is retried with backoff.
LLM_TIMEOUT_SECONDS=120
LLM_PRO_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2

# development | production | testing. Production enforces required secrets
# and secure cookies.
APP_ENV=development

# Recommended (REQUIRED in production): stable secret for session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Optional: legacy master password gate for the whole UI.
PASSWORD=

# Optional: port to bind (hosts like Render set this automatically).
PORT=5000
# Interface the `python wsgi.py` dev server listens on. Default 127.0.0.1
# (this machine only). Set 0.0.0.0 to expose it to your network, which lets
# anyone there run generated code billed to your key. The container's gunicorn
# always binds 0.0.0.0 inside the container and ignores this.
BIND_HOST=127.0.0.1

# --- Accounts & persistence (Tier 7) -------------------------------------
# Enable email/password accounts (registration UI appears in the app).
ACCOUNTS_ENABLED=true
# Force login for all API use (disables the anonymous sandbox mode).
REQUIRE_LOGIN=false
# Require new accounts to confirm their email (a link is emailed; needs SMTP_*
# below, otherwise the link is logged for dev). Off by default.
REQUIRE_EMAIL_VERIFICATION=false
# Public origin that emailed password-reset links point at, e.g.
# https://statlee.example.com (no trailing path). Links are never built from
# the request's Host header, which the requester controls. REQUIRED in
# production for password resets; without SMTP_* the reset link is logged only
# in development (never in production, where it would expose the token).
PUBLIC_BASE_URL=
# SQLAlchemy database URL. Empty -> SQLite file under instance/.
# Production example: postgresql+psycopg://user:pass@host:5432/statlee
# (needs the psycopg driver: the Docker image includes it; otherwise
# `pip install -r requirements-postgres.txt`).
DATABASE_URL=
# Skip the automatic schema upgrade the app runs at boot (1/true). `flask db`
# and `flask statlee-doctor` already skip it on their own; set this only to boot
# against a database you are repairing by hand.
# STATLEE_SKIP_BOOT_MIGRATE=

# Storage backend for uploads. Only `local` is implemented (`s3` is rejected
# at startup until a real backend exists).
STORAGE_BACKEND=local
# Root directory for uploaded/working files. Empty -> instance/uploads (stable
# across restarts). In production point it at a persistent volume.
UPLOAD_ROOT=

# --- Model routing & cost (3.4) --------------------------------------------
# Override any model id without touching code. Leave commented to use the
# per-provider defaults; set one to pin a specific model. MODEL_PRO is the
# default code-generation model; MODEL_PRO_MAX is the bigger model the in-app
# "Pro mode" toggle switches code generation to on demand.
# FOOTGUN: MODEL_PRO is the DEFAULT/"draft" tier used for EVERY normal
# generation -- setting it does NOT change what "Pro mode" runs. The Pro-mode
# model is MODEL_PRO_MAX. (The role name "pro" is historical; "pro_max" is the
# real Pro model.) To make Pro mode use a different model, set MODEL_PRO_MAX.
#   gemini   : MODEL_PRO=gemini-3.8-flash MODEL_PRO_MAX=gemini-4-argon
#              MODEL_FLASH=gemini-3.5-flash-lite MODEL_FLASH_LITE=gemini-3.5-flash-lite
#   anthropic: MODEL_PRO=claude-opus-5-5 MODEL_PRO_MAX=claude-fable-5-1
#              MODEL_FLASH=claude-sonnet-5-5 MODEL_FLASH_LITE=claude-haiku-5-5
#   openai   : MODEL_PRO=gpt-6.1-sol MODEL_PRO_MAX=gpt-6-astra
#              MODEL_FLASH=gpt-6-luna MODEL_FLASH_LITE=gpt-6-luna
# MODEL_PRO=
# MODEL_PRO_MAX=
# MODEL_FLASH=
# MODEL_FLASH_LITE=
# Which tier answers Converse questions: pro | flash | lite
CONVERSE_ROLE=flash
# Which tier runs conversational data cleaning ("delete column 2", "filter X").
# Defaults to the cheapest tier (lite) since these are short, structured edits.
WRANGLE_ROLE=lite
# Column count above which the analysis pipeline runs a feature-selection pass
# (picks the minimal relevant columns) before drafting code on wide datasets.
FEATURE_SELECTION_THRESHOLD=15

# --- Billing / cost guardrails (workstream E) --------------------------------
# >>> MONEY SAFETY <<< If you ever deploy with a real GEMINI_API_KEY, every LLM
# call costs YOU money. To let people trial the app without risking your wallet:
#   1) Keep BILLING_ENABLED=false (free trial) but ALWAYS set a low
#      MONTHLY_PRIORITY_CALL_CEILING so total priority spend is capped.
#   2) Keep RATE_LIMIT_* on (below) with a shared store so caps actually hold.
#   3) Use a Gemini key with a hard spend limit set in Google AI Studio billing.
# In production the app warns at startup when no ceiling is set.
#
# Turn on per-account credit debiting in billing.check_and_debit (off = no
# credits are ever debited; the ceiling below still applies).
BILLING_ENABLED=false
# Hard ceiling on priority (high-tier: Pro mode, report builder) requests per
# calendar month on the server's own key, enforced with BILLING_ENABLED on OR
# off (0 disables = UNCAPPED, not recommended once live). A coarse guardrail:
# per-process (multiplies by worker count) and in memory (resets on every
# restart/redeploy). Start low (e.g. 200) and raise it as you trust demand.
MONTHLY_PRIORITY_CALL_CEILING=200
# Free credits granted to a logged-in free-plan user, topped up lazily on their
# first request each calendar month (0 = off; every free user then starts at 0
# credits and needs a `flask grant-credits <email> <n>` grant). Only meaningful
# when BILLING_ENABLED=true.
MONTHLY_FREE_CREDITS=0

# --- Execution sandbox (Tier 0) ----------------------------------------------
# subprocess (default) | docker (sibling containers from runner.Dockerfile)
SANDBOX_MODE=subprocess
RUNNER_IMAGE=statlee-runner
# Parent dir for per-run sandbox work dirs. Empty -> system temp dir.
# REQUIRED for SANDBOX_MODE=docker when the app ITSELF runs in a container with
# the host docker socket mounted: `docker run -v` is resolved by the host
# daemon against the host filesystem, so set this to a path bind-mounted at the
# SAME absolute path into the app container (see docker-compose.yml). Example:
# SANDBOX_WORK_ROOT=/srv/statlee-runs
SANDBOX_WORK_ROOT=
EXEC_TIMEOUT=60
EXEC_MEMORY_MB=2048
# Max bytes of stdout+stderr captured from a sandbox run before truncation.
EXEC_OUTPUT_LIMIT=262144

# --- Limits ---------------------------------------------------------------------
MAX_UPLOAD_MB=16
# Decompression-bomb bounds: max total UNCOMPRESSED size (MB) of a zip-based
# upload (.xlsx), and max cells (rows x columns) of any parsed dataset.
# Uploads over either bound are rejected with 413 (0 disables that check).
MAX_UPLOAD_UNCOMPRESSED_MB=512
MAX_UPLOAD_CELLS=10000000
PDF_MAX_PAGES=50
DATA_PAGE_ROW_CAP=500000
# Per-identity storage caps (disk-fill abuse protection; 0 disables either cap).
# Version artifacts do not count toward the dataset count, only real uploads do.
MAX_DATASETS_PER_IDENTITY=10
MAX_BYTES_PER_IDENTITY=209715200
# Analysis runs kept per identity (the session workbook). Over the cap the
# oldest unstarred run is deleted, or the oldest run when every one is starred.
MAX_RUNS_PER_IDENTITY=50
# How long an anonymous session's uploaded files live before TTL cleanup (seconds).
FILE_TTL_SECONDS=7200
RATE_LIMIT_ENABLED=true
# Applies to any route with no explicit per-route limit below.
RATE_LIMIT_DEFAULT=120 per minute
RATE_LIMIT_RUN=10 per minute
RATE_LIMIT_CHAT=20 per minute
# Paged dataset reads for the data grid (/data_page).
RATE_LIMIT_DATA_PAGE=60 per minute
# Guards the token-consuming email-verification endpoint against brute force.
RATE_LIMIT_VERIFY=5 per minute
# Guards /login and /register against credential stuffing and mass signups.
RATE_LIMIT_AUTH=10 per minute
# Backing store for rate-limit counters. Default memory:// is PER-WORKER and
# resets on restart — with more than one gunicorn worker (WEB_CONCURRENCY>1) it
# does NOT enforce a shared limit, weakening bill-abuse protection. Use a shared
# store in production or pin WEB_CONCURRENCY=1. REDIS_URL is used as a fallback.
RATELIMIT_STORAGE_URI=
REDIS_URL=
# Gunicorn worker count in the container (see Dockerfile CMD). Keep a number
# here: gunicorn itself parses WEB_CONCURRENCY with int() at startup, so an
# empty value passed through docker compose's env_file crashes the container.
WEB_CONCURRENCY=1
# Trusted reverse-proxy hops in front of the app (enables ProxyFix so rate
# limiting sees the real client IP from X-Forwarded-For). Defaults to 0: keep it
# 0 if the app is exposed directly (otherwise clients can spoof the header to
# dodge per-IP limits). Behind one proxy (e.g. Render) set TRUST_PROXY_HOPS=1.
TRUST_PROXY_HOPS=

# --- Operator metrics (3.3, optional) -----------------------------------------
# /metrics returns uptime and every model's call and token totals for the whole
# server. Set a long random value here to read it with
# "Authorization: Bearer <token>" (or an X-Metrics-Token header); it then needs
# no session or login, in every environment. Leave empty to disable /metrics in
# production (404); development and testing keep it open behind the app gate.
METRICS_TOKEN=

# --- Issue-report email (6.3, optional) -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ISSUE_REPORT_TO=
